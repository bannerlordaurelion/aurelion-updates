<Prefab>
	<Window>

		<TextQueryParentWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" TextInputWidget="TextQueryParent\TextQueryContentList\TextInputParent\TextInputWidget" TextQueryParent="TextQueryParent">
			<Children>
<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_skin2\ink" AlphaFactor="0.62" DoNotAcceptEvents="true" />

				<!--Text Query-->
				<DimensionSyncWidget Id="TextQueryParent" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="512" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="-50" DimensionToSync="Vertical" WidgetToCopyHeightFrom="TextQueryContentList">
					<Children>

						<DimensionSyncWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="512" ClipContents="true" DimensionToSync="Vertical" WidgetToCopyHeightFrom="..\TextQueryContentList">
							<Children>
								<Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="512" HorizontalAlignment="Center" VerticalAlignment="Top" Sprite="aur_skin2\pop_9" />
							</Children>
						</DimensionSyncWidget>

						<ListPanel Id="TextQueryContentList" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="512" StackLayout.LayoutMethod="VerticalTopToBottom" MaxHeight="645">
							<Children>

								<!--Title-->
								<AutoHideRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="30" MarginRight="30" MarginTop="10" Brush="Aur.UI.PopTitle" MinHeight="50" Text="@TitleText" WidgetToHideIfEmpty="..\TitleDivider" />

								<!--Divider-->
								<Widget Id="TitleDivider" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" Sprite="aur_skin2\gh_line" />

								<!--Description-->
								<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"><Children><AutoHideRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="30" MarginRight="30" MarginTop="20" Brush="Aur.UI.PopBody" MaxHeight="480" MinHeight="10" Text="@PopUpLabel" WidgetToHideIfEmpty="..\." /></Children></Widget>

								<!--Text Input-->
								<Widget Id="TextInputParent" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="440" SuggestedHeight="52" MarginTop="22" MarginBottom="6" Sprite="aur_skin2\input_9" HorizontalAlignment="Center">
									<Children>
										<EditableTextWidget Id="TextInputWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="10" MarginRight="10" MarginTop="12" MarginBottom="12" Brush="Review.NameInput.Text" RealText="@InputText" IsObfuscationEnabled="@IsInputObfuscated" KeyboardInfoText="@TitleText"/>
									</Children>
								</Widget>

								<!--Control Buttons-->
								<NavigationForcedScopeCollectionTargeter CollectionParent="..\." />
								<NavigationScopeTargeter ScopeID="TextQueryPopupScope" ScopeParent="..\ControlButtons" ScopeMovements="Horizontal" />
								<ListPanel Id="ControlButtons" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="62" MarginBottom="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginLeft="35" MarginRight="35" StackLayout.LayoutMethod="HorizontalLeftToRight">
									<Children>

										<ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="204" SuggestedHeight="46" MarginLeft="6" MarginRight="6" HorizontalAlignment="Right" VerticalAlignment="Center" Brush="Aur.UI.Btn" Command.Click="ExecuteNegativeAction" IsVisible="@IsButtonCancelShown" GamepadNavigationIndex="0">
											<Children>
												<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="14" MarginRight="14" Brush="Aur.UI.Btn.Text" Text="@ButtonCancelLabel" />
												<InputKeyVisualWidget DataSource="{CancelInputKey}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="45" SuggestedHeight="45" HorizontalAlignment="Left" VerticalAlignment="Center" PositionXOffset="12" KeyID="@KeyID" IsVisible="@IsVisible"/>
											</Children>
										</ButtonWidget>

										<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="204" SuggestedHeight="46" MarginLeft="6" MarginRight="6" HorizontalAlignment="Right" VerticalAlignment="Center" GamepadNavigationIndex="1">
											<Children>
												<ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.UI.BtnPr" Command.Click="ExecuteAffirmativeAction" IsVisible="@IsButtonOkShown" IsEnabled="@IsButtonOkEnabled">
													<Children>
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="14" MarginRight="14" Brush="Aur.UI.Btn.Text" Text="@ButtonOkLabel" />
														<InputKeyVisualWidget DataSource="{DoneInputKey}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="45" SuggestedHeight="45" HorizontalAlignment="Left" VerticalAlignment="Center" PositionXOffset="12" KeyID="@KeyID" IsVisible="@IsVisible"/>
													</Children>
												</ButtonWidget>
												<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@IsButtonOkEnabled">
													<Children>
														<HintWidget DataSource="{DoneButtonDisabledReasonHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
													</Children>
												</Widget>
											</Children>
										</Widget>

									</Children>
								</ListPanel>

							</Children>
						</ListPanel>

						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_skin\clear" IsEnabled="false" />

						<!--Frame Border-->
						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_skin\clear" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />

					</Children>
				</DimensionSyncWidget>

			</Children>
		</TextQueryParentWidget>
		
	</Window>
</Prefab>