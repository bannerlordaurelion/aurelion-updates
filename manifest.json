  "news": [
    {
      "title": "Welcome to Bannerlord Aurelion",
      "titleAr": "أهلاً بيك في Bannerlord Aurelion",
      "body": "The Aurelion co-op campaign is live. Press PLAY and the launcher will install the server mods and take you straight into Calradia.",
      "bodyAr": "حملة Aurelion التعاونية بدأت. دوس العب، واللانشر هيسطّب مودات السيرفر ويدخّلك كالراديا على طول."
    },
    {
      "title": "Your progress is always safe",
      "titleAr": "تقدّمك دايماً محفوظ",
      "body": "The Aurelion server runs the Co-op mod around the clock, and the whole world is saved automatically every 5 minutes, so you can leave and come back whenever you like.",
      "bodyAr": "سيرفر Aurelion شغّال بمود Co-op على مدار اليوم، والعالم كله بيتحفظ لوحده كل 5 دقايق، فتقدر تخرج وترجع وقت ما تحب."
    },
    {
      "title": "Join the community",
      "titleAr": "انضم للمجتمع",
      "body": "Join our Discord to meet other players, get help and follow every update.",
      "bodyAr": "ادخل الديسكورد بتاعنا عشان تتعرف على اللاعبين، وتاخد مساعدة، وتتابع كل جديد.",
      "url": "https://discord.gg/8gG6tXm7R",
      "button": "Join our Discord",
      "buttonAr": "ادخل الديسكورد"
    }
  ],
  "guide": [
    {
      "icon": "E768",
      "numbered": true,
      "title": "Getting started",
      "titleAr": "إزاي تبدأ",
      "items": [
        "Own Mount & Blade II: Bannerlord on Steam and keep it updated.",
        "Keep Steam open and signed in.",
        "The first time, press INSTALL — the launcher downloads the server mods for you.",
        "Press PLAY — the game opens and joins the server automatically."
      ],
      "itemsAr": [
        "لازم تكون شاري Mount & Blade II: Bannerlord على Steam، واللعبة محدّثة لآخر نسخة.",
        "خلّي Steam مفتوح ومسجّل دخول.",
        "أول مرة دوس تسطيب، واللانشر هينزّل مودات السيرفر لوحده.",
        "دوس العب، واللعبة هتفتح وتدخّلك السيرفر على طول."
      ]
    },
    {
      "icon": "E82F",
      "title": "Good to know",
      "titleAr": "نصايح مهمة",
      "items": [
        "Don't install server mods by hand — the launcher keeps everything in sync.",
        "If Windows asks for permission, allow it. It is only used to write to the game folder.",
        "A green ping means your connection to the server is great.",
        "The world is saved every 5 minutes, so you can leave any time."
      ],
      "itemsAr": [
        "متسطّبش مودات السيرفر بإيدك، اللانشر بيظبط كل حاجة لوحده.",
        "لو Windows طلب إذن وافق عليه، ده بس عشان اللانشر يكتب في فولدر اللعبة.",
        "البينج الأخضر معناه إن اتصالك بالسيرفر ممتاز.",
        "العالم بيتحفظ كل 5 دقايق، فتقدر تخرج وقت ما تحب."
      ]
    },
    {
      "icon": "E90F",
      "title": "Troubleshooting",
      "titleAr": "مشاكل وحلولها",
      "items": [
        "Game not found: open Settings and press Auto-detect or Browse.",
        "Wrong game version: update Bannerlord in Steam and leave any beta branch.",
        "Conflicting copies: open the Mods page and press Fix.",
        "Can't join: check that your ping isn't red, then try again in a minute."
      ],
      "itemsAr": [
        "مش لاقي اللعبة: من الإعدادات دوس بحث تلقائي أو اختيار.",
        "نسخة اللعبة مختلفة: حدّث Bannerlord من Steam واقفل أي نسخة Beta.",
        "نسخ متعارضة: افتح صفحة المودات ودوس إصلاح.",
        "مش قادر تدخل: اتأكد إن البينج مش أحمر، وجرّب تاني بعد دقيقة."
      ]
    },
    {
      "icon": "E716",
      "title": "Need help?",
      "titleAr": "محتاج مساعدة؟",
      "items": [
        "The Aurelion team and community are on Discord.",
        "Report a problem, share an idea and follow every server update there."
      ],
      "itemsAr": [
        "فريق Aurelion والمجتمع كله موجودين على الديسكورد.",
        "بلّغ عن أي مشكلة، شارك أفكارك، وتابع كل جديد في السيرفر هناك."
      ],
      "url": "https://discord.gg/8gG6tXm7R",
      "button": "Join our Discord",
      "buttonAr": "ادخل الديسكورد"
    }
  ]
}
