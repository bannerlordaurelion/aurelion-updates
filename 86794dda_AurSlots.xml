<Prefab>
  <VisualDefinitions>
    <VisualDefinition Name="SlotLift" TransitionDuration="0.22" EaseType="EaseOut" EaseFunction="Quint">
      <VisualState State="Default" PositionYOffset="0" />
      <VisualState State="Hovered" PositionYOffset="-12" />
      <VisualState State="Pressed" PositionYOffset="-6" />
      <VisualState State="Disabled" PositionYOffset="0" />
    </VisualDefinition>
  </VisualDefinitions>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\shade" Color="#0B0A0CFF">
      <Children>
        <!-- the hall, drifting very slowly -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="-40" MarginRight="-40" MarginTop="-24" MarginBottom="-24" PositionXOffset="@BgX" PositionYOffset="@BgY" Sprite="aur_bg_hall_dim\bg" />
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\shade" Color="#0B0A0CFF" AlphaFactor="0.42" />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1700" SuggestedHeight="980" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="120" Sprite="aur_slot\spot" AlphaFactor="@SpotA" />

        <!-- embers -->
        <ListPanel DataSource="{Embers}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="1" HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="HorizontalLeftToRight" DoNotAcceptEvents="true">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="0" SuggestedHeight="0" DoNotAcceptEvents="true">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@S" SuggestedHeight="@S" PositionXOffset="@X" PositionYOffset="@Y" AlphaFactor="@A" Sprite="aur_slot\ember" DoNotAcceptEvents="true" />
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\vignette" DoNotAcceptEvents="true" />

        <!-- header -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="24" PositionYOffset="@HeadY" AlphaFactor="@HeadA" StackLayout.LayoutMethod="VerticalTopToBottom">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="56" SuggestedHeight="56" HorizontalAlignment="Center">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="130" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="aur_slot\ember" AlphaFactor="@Pulse" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_cult\medal" />
              </Children>
            </Widget>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="900" SuggestedHeight="22" HorizontalAlignment="Center" MarginTop="8" Brush="Aur.Slot.Kicker" Text="@Kicker" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1300" SuggestedHeight="58" HorizontalAlignment="Center" MarginTop="0" Brush="Aur.Slot.Title" Text="@Title" />
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="340" SuggestedHeight="18" HorizontalAlignment="Center" MarginTop="6" Sprite="aur_slot\divider" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="1100" HorizontalAlignment="Center" MarginTop="8" Brush="Aur.Slot.Sub" Text="@Sub" />
          </Children>
        </ListPanel>

        <!-- reading the server -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="80" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsLoading">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="96" HorizontalAlignment="Center">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="190" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="aur_slot\ember" AlphaFactor="@Pulse" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_cult\medal" />
              </Children>
            </Widget>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="900" SuggestedHeight="40" HorizontalAlignment="Center" MarginTop="18" Brush="Aur.Slot.Loading" Text="@LoadingText" />
          </Children>
        </ListPanel>

        <!-- the lineages -->
        <ListPanel DataSource="{Cards}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="238" StackLayout.LayoutMethod="HorizontalLeftToRight" IsHidden="@IsLoading">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="440" SuggestedHeight="720" MarginLeft="30" MarginRight="30" PositionYOffset="@Y" AlphaFactor="@Alpha">
              <Children>
                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="56" Brush="Aur.Slot.Hit" Command.Click="ExecutePick" IsEnabled="@CanEnter" UpdateChildrenStates="true" VisualDefinition="SlotLift">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="-60" MarginRight="-60" MarginTop="-60" MarginBottom="-60" Brush="Aur.Slot.Glow" DoNotAcceptEvents="true" />
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.Slot.Card" DoNotAcceptEvents="true" />

                    <!-- the art window -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="380" MarginLeft="9" MarginRight="9" MarginTop="9" ClipContents="true" DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@KnownArt" DoNotAcceptEvents="true">
                          <Children>
                            <CharacterCreationCultureVisualBrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="422" SuggestedHeight="1039" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="-12" UseSmallVisuals="false" CurrentCultureId="@CultureId" Layer1Widget="SlotArt" Brush="Aur.UI.Clear" DoNotAcceptEvents="true"><Children><ParallaxItemBrushWidget Id="SlotArt" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.Cult.Art" OneDirectionDuration="6" OneDirectionDistance="0" DoNotAcceptEvents="true" /></Children></CharacterCreationCultureVisualBrushWidget>
                          </Children>
                        </Widget>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\art_unknown" IsVisible="@UnknownArt" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\empty_art" IsVisible="@IsEmpty" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="120" VerticalAlignment="Top" Sprite="aur_slot\topfade" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="230" VerticalAlignment="Bottom" Sprite="aur_slot\fade" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="260" SuggestedHeight="760" VerticalAlignment="Top" MarginTop="-170" PositionXOffset="@ShineX" Sprite="aur_slot\shine" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aur_slot\shade" Color="#F0D08AFF" AlphaFactor="@Flash" DoNotAcceptEvents="true" />
                      </Children>
                    </Widget>

                    <!-- empty: the sigil -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="132" SuggestedHeight="132" HorizontalAlignment="Center" MarginTop="128" Sprite="aur_slot\plus_ring" IsVisible="@IsEmpty" DoNotAcceptEvents="true" />

                    <!-- corner marks -->
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="22" HorizontalAlignment="Left" MarginLeft="24" MarginTop="22" StackLayout.LayoutMethod="HorizontalLeftToRight" DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="14" SuggestedHeight="14" VerticalAlignment="Center" Sprite="aur_slot\dot_gold" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="6" Brush="Aur.Slot.Badge" Text="@Badge" />
                      </Children>
                    </ListPanel>
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="22" HorizontalAlignment="Right" MarginRight="24" MarginTop="22" StackLayout.LayoutMethod="HorizontalLeftToRight" IsVisible="@IsBusy" DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="14" SuggestedHeight="14" VerticalAlignment="Center" Sprite="aur_slot\dot_red" AlphaFactor="@Blink" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="6" Brush="Aur.Slot.BadgeR" Text="@BusyText" />
                      </Children>
                    </ListPanel>

                    <!-- body -->
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" MarginLeft="26" MarginRight="26" MarginTop="310" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true" UpdateChildrenStates="true">
                      <Children>
                        <!-- filled -->
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsFilled" UpdateChildrenStates="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46" Brush="Aur.Slot.Name" Text="@Name" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" Brush="Aur.Slot.Line" Text="@Line" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="14" HorizontalAlignment="Center" MarginTop="10" Sprite="aur_slot\divider_s" />
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="10" StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="176" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Center" Sprite="aur_slot\ic_coin" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginTop="2" Brush="Aur.Slot.StatG" Text="@Gold" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16" Brush="Aur.Slot.StatL" Text="@GoldL" />
                                  </Children>
                                </ListPanel>
                                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="176" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Center" Sprite="aur_slot\ic_crown" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginTop="2" Brush="Aur.Slot.StatV" Text="@Kingdom" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16" Brush="Aur.Slot.StatL" Text="@KingdomL" />
                                  </Children>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="10" StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="176" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Center" Sprite="aur_slot\ic_shield" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginTop="2" Brush="Aur.Slot.StatV" Text="@Rank" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16" Brush="Aur.Slot.StatL" Text="@RankL" />
                                  </Children>
                                </ListPanel>
                                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="176" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Center" Sprite="aur_slot\ic_glass" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginTop="2" Brush="Aur.Slot.StatV" Text="@Seen" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16" Brush="Aur.Slot.StatL" Text="@SeenL" />
                                  </Children>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                        <!-- empty -->
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsEmpty" UpdateChildrenStates="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Brush="Aur.Slot.EmptyTitle" Text="@EmptyTitle" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="14" HorizontalAlignment="Center" MarginTop="10" Sprite="aur_slot\divider_s" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" MarginLeft="10" MarginRight="10" Brush="Aur.Slot.EmptySub" Text="@EmptySub" />
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="18" StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_empire" AlphaFactor="0.8" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_vlandia" AlphaFactor="0.8" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_sturgia" AlphaFactor="0.8" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_battania" AlphaFactor="0.8" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_khuzait" AlphaFactor="0.8" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" MarginLeft="5" MarginRight="5" Sprite="aur_cult\embs_aserai" AlphaFactor="0.8" />
                              </Children>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                      </Children>
                    </ListPanel>

                    <!-- call to action (styled by the card's state: hover lights it) -->
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54" VerticalAlignment="Bottom" MarginLeft="26" MarginRight="26" MarginBottom="24" Brush="Aur.UI.BtnPr" DoNotAcceptEvents="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.Slot.Cta" Text="@ActionText" />
                      </Children>
                    </BrushWidget>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Bottom" MarginBottom="-30" Brush="Aur.Slot.Warn" Text="@Status" />

                    <!-- the seal (hangs over the card's top edge) -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="112" SuggestedHeight="112" HorizontalAlignment="Center" MarginTop="-56" Sprite="aur_slot\seal" DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="58" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@IsFilled">
                          <Children>
                            <CharacterCreationCultureVisualBrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="58" HorizontalAlignment="Center" VerticalAlignment="Top" UseSmallVisuals="false" CurrentCultureId="@CultureId" Layer1Widget="SlotEmb" Brush="Aur.UI.Clear" DoNotAcceptEvents="true"><Children><ParallaxItemBrushWidget Id="SlotEmb" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.Cult.EmbS" OneDirectionDuration="6" OneDirectionDistance="0" DoNotAcceptEvents="true" /></Children></CharacterCreationCultureVisualBrushWidget>
                          </Children>
                        </Widget>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.Slot.Title" Brush.FontSize="40" Brush.FontColor="#F0D08AFF" Text="@Numeral" IsVisible="@IsEmpty" />
                      </Children>
                    </Widget>
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- footer -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" VerticalAlignment="Bottom" MarginLeft="60" MarginRight="60" MarginBottom="36" AlphaFactor="@HeadA">
          <Children>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="52" HorizontalAlignment="Left" VerticalAlignment="Center" Brush="Aur.UI.Btn" Command.Click="ExecuteBack" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Aur.UI.Btn.Text" Text="@BackText" />
              </Children>
            </ButtonWidget>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="900" HorizontalAlignment="Center" Brush="Aur.Slot.Foot" Text="@Foot" />
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" StackLayout.LayoutMethod="HorizontalLeftToRight" IsVisible="@HasLive">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="14" SuggestedHeight="14" VerticalAlignment="Center" Sprite="aur_slot\dot_green" AlphaFactor="@Blink" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="8" Brush="Aur.Slot.Live" Text="@LiveText" />
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
