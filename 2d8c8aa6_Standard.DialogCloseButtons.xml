<Prefab>
  <Parameters>
    <Parameter Name="ShowCancel" DefaultValue="true"/>
    <Parameter Name="ShowDone" DefaultValue="true"/>
    <Parameter Name="CancelButtonText" DefaultValue="- Missing -"/>
    <Parameter Name="DoneButtonText" DefaultValue="- Missing -"/>
    <Parameter Name="CancelButtonAction" DefaultValue=""/>
    <Parameter Name="DoneButtonAction" DefaultValue=""/>
    <Parameter Name="NavigationScopeMovements" DefaultValue="Horizontal"/>
    <Parameter Name="CancelButtonNavigationIndex" DefaultValue="-1"/>
    <Parameter Name="DoneButtonNavigationIndex" DefaultValue="-1"/>
    <Parameter Name="CancelInputKeyDataSource" DefaultValue=""/>
    <Parameter Name="DoneInputKeyDataSource" DefaultValue=""/>
    <Parameter Name="IsDoneEnabled" DefaultValue="true"/>
  </Parameters>
  <Window>
    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="22">
      <Children>
        <NavigationScopeTargeter ScopeID="DialogCloseButtonsScope" ScopeParent="..\." ScopeMovements="*NavigationScopeMovements" HasCircularMovement="true"/>
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="230" SuggestedHeight="56" MarginRight="9" Brush="Aur.UI.Btn" Command.Click="*CancelButtonAction" IsEnabled="*ShowCancel" IsVisible="*ShowCancel" UpdateChildrenStates="true" GamepadNavigationIndex="*CancelButtonNavigationIndex">
          <Children>
            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" Brush="Aur.UI.Btn.Text" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="*CancelButtonText"/>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" PositionXOffset="-46">
              <Children>
                <InputKeyVisualWidget DataSource="*CancelInputKeyDataSource" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="42" SuggestedHeight="42" KeyID="@KeyID" IsVisible="@IsVisible"/>
              </Children>
            </Widget>
          </Children>
        </ButtonWidget>
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="230" SuggestedHeight="56" MarginLeft="9" Brush="Aur.UI.BtnPr" Command.Click="*DoneButtonAction" IsEnabled="*IsDoneEnabled" IsVisible="*ShowDone" UpdateChildrenStates="true" GamepadNavigationIndex="*DoneButtonNavigationIndex">
          <Children>
            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" Brush="Aur.UI.Btn.Text" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="*DoneButtonText"/>
            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" IsVisible="*IsDoneEnabled" HorizontalAlignment="Left" VerticalAlignment="Center" PositionXOffset="-46">
              <Children>
                <InputKeyVisualWidget DataSource="*DoneInputKeyDataSource" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="42" SuggestedHeight="42" KeyID="@KeyID" IsVisible="@IsVisible"/>
              </Children>
            </Widget>
          </Children>
        </ButtonWidget>
      </Children>
    </ListPanel>
  </Window>
</Prefab>
